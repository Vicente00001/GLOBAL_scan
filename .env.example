# ⚙️ Variables de Entorno - Supabase

# Obtén estos valores desde: https://app.supabase.com/project/_/settings/api

# URL de tu proyecto Supabase
# Ejemplo: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave Anon (pública) de Supabase
# Es la clave que comienza con eyJ... (sin incluir 'eyJ')
SUPABASE_ANON_KEY=

# Nota: Nunca compartas la SUPABASE_ANON_KEY en repositorios públicos
# En desarrollo local, puedes usarla aquí sin problema
